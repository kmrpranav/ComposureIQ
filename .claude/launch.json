{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd backend && .venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000"],
      "port": 8000
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd dashboard && npx vite --port 5173 --strictPort"],
      "port": 5173
    }
  ]
}
